# ============================================================
# Dead Lead Follow-up — secrets & configuration reference
# ============================================================
# The n8n workflow itself stores credentials inside n8n's own
# credential store (never in this repo). This file documents
# everything you need to provision, and optional variables for
# managing a self-hosted n8n instance.

# --- OpenRouter -------------------------------------------------
# Create at https://openrouter.ai/keys — paste into the n8n
# "OpenRouter Chat Model" credential.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- ClickUp ----------------------------------------------------
# n8n uses OAuth or a personal API token for its ClickUp
# credential (create in ClickUp: Settings > Apps > API Token).
CLICKUP_API_TOKEN=

# IDs of your board (Settings > copy from list URL):
#   .../app/<TEAM_ID>/v/s/<SPACE_ID>/f/<LIST_ID>
CLICKUP_TEAM_ID=
CLICKUP_SPACE_ID=
CLICKUP_LIST_ID=

# --- Google / Gmail ---------------------------------------------
# GCP OAuth client used by the n8n "Gmail OAuth2" credential.
# Redirect URI: http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Booking link ------------------------------------------------
# Your Tally / Calendly / Cal.com form slug shown on the CTA button.
BOOKING_URL=https://tally.so/r/YOUR_TALLY_FORM_SLUG

# --- Self-hosted n8n management (optional) -----------------------
# Public API key for programmatic workflow edits (n8n: Settings > n8n API).
N8N_API_KEY=
# Instance timezone so the daily 10:00 trigger fires when you expect it.
GENERIC_TIMEZONE=UTC
