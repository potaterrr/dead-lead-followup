{
  "_comment": "Import into n8n (Workflows > Import from File), then attach your own credentials to the ClickUp/Gmail/OpenRouter nodes and replace every YOUR_* placeholder. See README.md - Setup.",
  "name": "Dead Lead Retrieval",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 10
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "id": "bbbb0001-0000-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "team": "YOUR_CLICKUP_TEAM_ID",
        "space": "YOUR_CLICKUP_SPACE_ID",
        "folderless": true,
        "list": "YOUR_CLICKUP_LIST_ID",
        "resource": "task",
        "operation": "getAll",
        "name": "={{ '' }}",
        "returnAll": true,
        "filters": {
          "statuses": [
            "to do"
          ]
        }
      },
      "type": "n8n-nodes-base.clickUp",
      "typeVersion": 1,
      "id": "bbbb0001-0000-4000-8000-000000000002",
      "name": "Get Dead Leads",
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a warm, personable B2B copywriter specializing in warm, low-pressure B2B follow-ups. Write a short, friendly, 3-sentence check-in email to a dormant lead.\n\nRules:\n- Don't include the subject in the draft.\n- Keep the tone conversational, warm, and highly human (never corporate or stiff).\n- Reference their original interest notes or project goals.\n- End with an easy, low-friction question that invites a simple reply.\n- If a phone call would be easier for them, invite one warmly, ending that line with exactly: You can grab a time on my calendar here:\n- Never invent or include any URLs yourself.\n- Sign off using the exact closing style provided below.\n\nLead Information:\n- Lead Name: {{ (($('Get Dead Leads').item.json.custom_fields.find(f => f.name === 'Name') || {}).value || $('Get Dead Leads').item.json.name).trim() }}\n- Company / Project: {{ $('Get Dead Leads').item.json.custom_fields.find(f => f.name === 'Company Name')?.value || 'your company' }}\n- Original Interest / Notes: {{ ($('Get Dead Leads').item.json.custom_fields.find(f => /interest/i.test(f.name)) || {}).value || '' }}\n\nSign-off style to use:\nBest,\nYour Name (Founder) \ud83e\udd44",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.5,
      "id": "bbbb0001-0000-4000-8000-000000000003",
      "name": "Generate AI Follow-up",
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "model": "google/gemini-2.5-flash-lite",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "id": "bbbb0001-0000-4000-8000-000000000004",
      "name": "OpenRouter Chat Model",
      "position": [
        480,
        220
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "authentication": "oAuth2",
        "subject": "\ud83d\udd0d Quick check-in \u2014 still exploring options?",
        "emailType": "html",
        "message": "={{ $json.output.replace(/\\n/g, '<br>') }}<br><br><a href=\"https://tally.so/r/YOUR_TALLY_FORM_SLUG\" style=\"display:inline-block;background-color:#2563eb;color:#ffffff;padding:12px 24px;border-radius:8px;text-decoration:none;font-weight:bold;font-family:Arial,sans-serif;\">\ud83d\udcc5 Schedule a Call</a>",
        "options": {
          "sendTo": "={{ (($('Get Dead Leads').item.json.custom_fields || []).find(c => /mail/i.test(c.name || '')) || {}).value || (($('Get Dead Leads').item.json.custom_fields || [])[1] || {}).value || '' }}"
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "id": "bbbb0001-0000-4000-8000-000000000005",
      "name": "Create a draft",
      "position": [
        780,
        0
      ],
      "webhookId": "b8d57ac9-4db2-4fe5-9a68-d1124663e9ae"
    },
    {
      "parameters": {
        "team": "YOUR_CLICKUP_TEAM_ID",
        "space": "YOUR_CLICKUP_SPACE_ID",
        "folderless": true,
        "list": "YOUR_CLICKUP_LIST_ID",
        "resource": "task",
        "operation": "update",
        "id": "={{ $('Get Dead Leads').item.json.id }}",
        "name": "={{ $('Get Dead Leads').item.json.name }}",
        "updateFields": {
          "status": "Draft Done"
        }
      },
      "type": "n8n-nodes-base.clickUp",
      "typeVersion": 1,
      "id": "bbbb0001-0000-4000-8000-000000000006",
      "name": "Set Draft Done",
      "position": [
        1040,
        0
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Dead Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Dead Leads": {
      "main": [
        [
          {
            "node": "Generate AI Follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenRouter Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Generate AI Follow-up",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Generate AI Follow-up": {
      "main": [
        [
          {
            "node": "Create a draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create a draft": {
      "main": [
        [
          {
            "node": "Set Draft Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}